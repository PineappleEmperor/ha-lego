#!/usr/bin/env bash
# Enforce terse Conventional Commit subjects and reject AI attribution trailers.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

MSG_FILE="$1"
SUBJECT=$(head -n1 "$MSG_FILE")

# Allow merge and revert commits through untouched.
case "$SUBJECT" in
  Merge*|Revert*) exit 0 ;;
esac

CONVENTIONAL='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'
if ! printf '%s' "$SUBJECT" | grep -Eq "$CONVENTIONAL"; then
  echo "commit-msg: subject must be a Conventional Commit, e.g. 'fix(api): retry on timeout'" >&2
  exit 1
fi

if [ "${#SUBJECT}" -gt 72 ]; then
  echo "commit-msg: subject is ${#SUBJECT} chars; keep it under 72" >&2
  exit 1
fi

if grep -Eiq '^(co-authored-by:.*(claude|copilot|chatgpt|gpt-)|generated with)' "$MSG_FILE"; then
  echo "commit-msg: remove AI attribution trailers; authorship is human" >&2
  exit 1
fi

exit 0
